    "version": "0.2.0",
    "configurations": [
        {
            "name": "i-Royal",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "PRODUCTION",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "prod",
                "--debug",
            ]
        },
        {
            "name": "DEVELOPMENT",
            "type": "dart",
            "request": "launch",
            "program": "lib/main_dev.dart",
            "args": [
                "--flavor",
                "dev",
                "--debug",
            ]
        },
        {
            "name": "STAGING",
            "type": "dart",
            "request": "launch",
            "program": "lib/main_staging.dart",
            "args": [
                "--flavor",
                "staging",
                "--debug",
            ]
        },
        {
            "name": "PRODUCTION IOS",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "--target",
                "lib/main.dart",
            ]
        },
        {
            "name": "DEVELOPMENT IOS",
            "type": "dart",
            "request": "launch",
            "program": "lib/main_dev.dart",
            "args": [
                "--target",
                "lib/main_dev.dart"
            ]
        },
        {
            "name": "STAGING IOS",
            "type": "dart",
            "request": "launch",
            "program": "lib/main_staging.dart",
            "args": [
                "--target",
                "lib/main_staging.dart",
            ]
        },
    ]
}